{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minantaya-sistema",
  "account_id": "0acfa25b5f619f94d581b8cf882e2eec",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minantaya-db",
      "database_id": "5b701264-4246-4025-b54c-d795e50f9312",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "minantaya-documents"
    }
  ],
  "vars": {
    "APP_ENV": "development"
  },
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
